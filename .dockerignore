.git
.github

# Compose's own environment file, at the repository root. The image takes its
# configuration from the container environment, never from a file baked in.
.env*

# Packaging and documentation live at the root and stay out of the image.
# docker/ is NOT excluded: the Dockerfile copies php.ini and entrypoint.sh.
docs/
compose.yaml
compose.override.yaml
README.md
README.fr.md
CHANGELOG.md
LICENSE

# Rebuilt in the vendor stage
src/vendor/

# The application's own environment file. src/env (CI4's template, copied to
# .env by whoever installs from source) is kept — harmless, and useful as a
# reference for anyone inspecting the image.
src/.env

# Runtime data — belongs in the writable/ volume, never in the image
src/writable/cache/*
src/writable/logs/*
src/writable/session/*
src/writable/debugbar/*
src/writable/tmp/*
src/writable/uploads/*
src/writable/backups/*
src/writable/keys/*
src/writable/storage/*
src/writable/*.db

# Build artifacts and local tooling — regenerated by `update:manifest`, which
# only ever runs from a source checkout, never inside the image
src/manifest.json
src/manifest.json.sig
src/release-signing.key
src/release_*.zip
src/build/
src/.phpunit.cache/
src/.phpunit.result.cache
src/tests/
src/phpunit.dist.xml
