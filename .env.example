# Copy to .env next to compose.yaml, then:
#   docker compose up -d
#
# This file configures Compose and the container, and belongs at the
# repository root. The application has its own environment file at src/.env
# — separate directories, so neither can overwrite the other.
#
# These are the variables the container itself reads, so they use
# CodeIgniter's underscore naming. Compose passes them through verbatim —
# including the $ in a bcrypt hash, which substitution would otherwise mangle.

# --- Application ------------------------------------------------------------

# Public URL, trailing slash included. NuGet clients are told where to fetch
# packages from using this, so it has to be how they actually reach the
# server — see the "Behind a reverse proxy" note in docs/docker.md.
app_baseURL=https://pepite.example.com/

# Redirect everything to HTTPS. The .NET SDK refuses HTTP sources outright,
# so this is almost never what you want off — leave it on unless a proxy in
# front of this container already terminates TLS.
app_forceGlobalSecureRequests=true

# --- Database ---------------------------------------------------------------
# The host, driver and port are set by compose.yaml; these are yours to
# choose. A literal $ in the password must be doubled ($$): the database
# container receives it through Compose substitution.

database_default_database=pepite
database_default_username=pepite
database_default_password=change-me

# --- First admin --------------------------------------------------------------
# Created on first start, then re-activated and re-synced on every start —
# also the recovery path if you lock yourself out later.

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Prefer keeping the plaintext out of this file? Supply a bcrypt hash
# instead — but double every $, because Compose interpolates them and a
# mangled hash yields an account that accepts no password:
#   php -r "echo str_replace('$', '$$', password_hash('yourpassword', PASSWORD_DEFAULT)) . PHP_EOL;"
# ADMIN_PASSWORD_HASH=

# --- Host ---------------------------------------------------------------
# Port published on the host. Behind a reverse proxy, binding to loopback
# only is usually better: APP_PORT=127.0.0.1:8080
APP_PORT=8080
